<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Task Created</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main>

        <div class="header">
            <h1>Task Created!</h1>
            <p>Your task has been submitted successfully.</p>
        </div>

        <section class="task-form">

            <h2>
                <%= title %>
            </h2>

            <p>
                <%= description %>
            </p>

            <a href="/">
                Create another task
            </a>

        </section>

    </main>

</body>

</html>