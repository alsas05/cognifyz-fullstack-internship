<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TaskFlow | Create Task</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>


    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                ✓ TaskFlow
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#/dashboard" onclick="showPage('dashboard')">
    Dashboard
</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#/create-task" onclick="showPage('create-task')">
    Create Task
</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <!-- Dashboard Route -->
    <div id="dashboardPage" class="route-page">
        <!-- Hero Section -->
        <section class="hero-section">
            <div class="container">
                <div class="row align-items-center">

                    <div class="col-lg-7">
                        <span class="badge hero-badge mb-3">
                        TASK MANAGEMENT
                    </span>

                        <h1 class="hero-title">
                            Organize your work.<br>
                            <span>Achieve more.</span>
                        </h1>

                        <p class="hero-text">
                            Create and organize your tasks with TaskFlow. Set priorities, categories and deadlines to stay on top of your work.
                        </p>

                        <a href="#/create" class="btn btn-primary hero-button" onclick="showPage('create')">
    Create a Task →
</a>
                    </div>

                    <div class="col-lg-5 mt-5 mt-lg-0">
                        <div class="hero-card">
                            <div class="hero-card-icon">✓</div>
                            <h4>Stay Organized</h4>
                            <p>
                                Keep your tasks structured and manage your priorities efficiently.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </section>


        <!-- Features Section -->
        <section class="features-section">
            <div class="container">

                <div class="text-center section-heading">
                    <span>WHY TASKFLOW?</span>
                    <h2>Everything you need to stay productive</h2>
                </div>

                <div class="row g-4">

                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon">🎯</div>
                            <h4>Set Priorities</h4>
                            <p>
                                Mark tasks as Low, Medium or High priority so you know what needs attention first.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon">📁</div>
                            <h4>Organize Tasks</h4>
                            <p>
                                Categorize your tasks into Work, Study or Personal activities.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon">📅</div>
                            <h4>Track Deadlines</h4>
                            <p>
                                Add due dates to keep your work on schedule and avoid missing important deadlines.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </div>
    <!-- Create Task Route -->
    <div id="createPage" class="route-page">
        <!-- Create Task Section -->
        <section class="create-section" id="create-task">
            <div class="container">

                <div class="row justify-content-center">
                    <div class="col-lg-8">

                        <div class="form-card">

                            <div class="form-header">
                                <span class="section-label">NEW TASK</span>
                                <h2>Create a Task</h2>
                                <p>
                                    Add the details of your task below.
                                </p>
                            </div>

                            <form action="/tasks" method="POST" onsubmit="return validateForm()">

                                <!-- Title -->
                                <div class="mb-4">
                                    <label for="title" class="form-label">
                                    Task Title
                                </label>

                                    <input type="text" class="form-control" id="title" name="title" placeholder="e.g. Build Portfolio Website">
                                </div>


                                <!-- Description -->
                                <div class="mb-4">
                                    <label for="description" class="form-label">
                                    Description
                                </label>

                                    <textarea class="form-control" id="description" name="description" rows="4" placeholder="Describe what needs to be done..."></textarea>
                                </div>
                                <!-- Password -->
                                <div class="mb-4">
                                    <label for="password" class="form-label">
        Security Password
    </label>

                                    <input type="password" class="form-control" id="password" name="password" placeholder="Enter a secure password" oninput="checkTask4PasswordStrength()">

                                    <div class="password-strength">
                                        <div class="strength-bar">
                                            <div id="strengthFill"></div>
                                        </div>

                                        <small id="strengthText">
            Password strength: Not entered
        </small>
                                    </div>

                                    <ul class="password-rules">
                                        <li id="lengthRule">At least 8 characters</li>
                                        <li id="upperRule">One uppercase letter</li>
                                        <li id="numberRule">One number</li>
                                        <li id="specialRule">One special character</li>
                                    </ul>
                                </div>


                                <!-- Priority + Category -->
                                <div class="row">

                                    <div class="col-md-6 mb-4">
                                        <label for="priority" class="form-label">
                                        Priority
                                    </label>

                                        <select class="form-select" id="priority" name="priority" onchange="updatePriorityMessage()">
                                        <option value="">Select priority</option>
                                        <option value="Low">Low</option>
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>
                                    </select>
                                        <div id="priorityMessage"></div>
                                    </div>


                                    <div class="col-md-6 mb-4">
                                        <label for="category" class="form-label">
                                        Category
                                    </label>

                                        <select class="form-select" id="category" name="category">
                                        <option value="">Select category</option>
                                        <option value="Work">Work</option>
                                        <option value="Study">Study</option>
                                        <option value="Personal">Personal</option>
                                    </select>
                                    </div>

                                </div>


                                <!-- Due Date -->
                                <div class="mb-4">
                                    <label for="dueDate" class="form-label">
                                    Due Date
                                </label>

                                    <input type="date" class="form-control" id="dueDate" name="dueDate">
                                </div>


                                <button type="submit" class="btn submit-button">
                                Create Task
                            </button>

                            </form>

                        </div>

                    </div>
                </div>

            </div>
        </section>
    </div>


    <!-- Footer -->
    <footer class="footer">
        <div class="container text-center">
            <p>TaskFlow • Simple task management for better productivity</p>
        </div>
    </footer>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Client-side Validation -->
    <script>
        // =========================================
        // TASK 4 PASSWORD STRENGTH
        // =========================================

        function checkTask4PasswordStrength() {

            const password =
                document.getElementById("password").value;

            const strengthFill =
                document.getElementById("strengthFill");

            const strengthText =
                document.getElementById("strengthText");

            const lengthRule =
                document.getElementById("lengthRule");

            const upperRule =
                document.getElementById("upperRule");

            const numberRule =
                document.getElementById("numberRule");

            const specialRule =
                document.getElementById("specialRule");


            const hasLength = password.length >= 8;
            const hasUpper = /[A-Z]/.test(password);
            const hasNumber = /[0-9]/.test(password);
            const hasSpecial = /[^A-Za-z0-9]/.test(password);


            // Update password rules

            lengthRule.classList.toggle(
                "valid-rule",
                hasLength
            );

            upperRule.classList.toggle(
                "valid-rule",
                hasUpper
            );

            numberRule.classList.toggle(
                "valid-rule",
                hasNumber
            );

            specialRule.classList.toggle(
                "valid-rule",
                hasSpecial
            );


            // Calculate strength

            let strength = 0;

            if (hasLength) {
                strength++;
            }

            if (hasUpper) {
                strength++;
            }

            if (hasNumber) {
                strength++;
            }

            if (hasSpecial) {
                strength++;
            }


            // Display strength

            if (strength === 0) {

                strengthFill.style.width = "0%";

                strengthText.textContent =
                    "Password strength: Weak";

            } else if (strength === 1) {

                strengthFill.style.width = "25%";

                strengthText.textContent =
                    "Password strength: Weak";

            } else if (strength === 2 || strength === 3) {

                strengthFill.style.width = "65%";

                strengthText.textContent =
                    "Password strength: Medium";

            } else {

                strengthFill.style.width = "100%";

                strengthText.textContent =
                    "Password strength: Strong";
            }
        }
        // =========================================
        // DYNAMIC DOM - PRIORITY MESSAGE
        // =========================================

        function updatePriorityMessage() {

            const priority =
                document.getElementById("priority").value;

            const message =
                document.getElementById("priorityMessage");


            // Clear existing content
            message.innerHTML = "";


            if (priority === "Low") {

                message.innerHTML =
                    "<p class='priority-message'>✓ Low priority — this task can be handled when convenient.</p>";

            } else if (priority === "Medium") {

                message.innerHTML =
                    "<p class='priority-message'>⚡ Medium priority — try to complete this task on schedule.</p>";

            } else if (priority === "High") {

                message.innerHTML =
                    "<p class='priority-message'>🔥 High priority — this task needs your immediate attention.</p>";
            }
        }
        // =========================================
        // CLIENT-SIDE ROUTING
        // =========================================

        function showPage(page) {

            const dashboard =
                document.getElementById("dashboardPage");

            const create =
                document.getElementById("createPage");

            if (page === "dashboard") {

                dashboard.style.display = "block";
                create.style.display = "none";

                window.scrollTo(0, 0);

            } else if (page === "create") {

                dashboard.style.display = "none";
                create.style.display = "block";

                window.scrollTo(0, 0);
            }
        }


        // Handle browser back/forward and direct URLs

        function handleRoute() {

            const route = window.location.hash;

            if (route === "#/create") {

                showPage("create");

            } else {

                showPage("dashboard");
            }
        }


        window.addEventListener("hashchange", handleRoute);

        window.addEventListener("load", handleRoute);


        // =========================================
        // FORM VALIDATION
        // =========================================

        function validateForm() {

            const title =
                document.getElementById("title").value.trim();

            const description =
                document.getElementById("description").value.trim();

            const priority =
                document.getElementById("priority").value;

            const category =
                document.getElementById("category").value;

            const dueDate =
                document.getElementById("dueDate").value;

            const password =
                document.getElementById("password").value;


            if (title.length < 3) {

                alert(
                    "Task title must contain at least 3 characters."
                );

                return false;
            }


            if (description.length < 10) {

                alert(
                    "Description must contain at least 10 characters."
                );

                return false;
            }


            if (priority === "") {

                alert("Please select a priority.");

                return false;
            }


            if (category === "") {

                alert("Please select a category.");

                return false;
            }


            if (dueDate === "") {

                alert("Please select a due date.");

                return false;
            }


            if (password.length < 8) {

                alert(
                    "Password must contain at least 8 characters."
                );

                return false;
            }


            if (!/[A-Z]/.test(password)) {

                alert(
                    "Password must contain at least one uppercase letter."
                );

                return false;
            }


            if (!/[0-9]/.test(password)) {

                alert(
                    "Password must contain at least one number."
                );

                return false;
            }


            if (!/[^A-Za-z0-9]/.test(password)) {

                alert(
                    "Password must contain at least one special character."
                );

                return false;
            }


            return true;
        }
    </script>

</body>

</html>