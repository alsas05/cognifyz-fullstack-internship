<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TaskFlow | Task Created</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
        <div class="container">

            <a class="navbar-brand fw-bold" href="/">
                ✓ TaskFlow
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" href="/">
                            Create Task
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>


    <!-- Success Section -->
    <main class="success-section">

        <div class="container">

            <div class="success-card">

                <!-- Success Icon -->
                <div class="success-icon">
                    ✓
                </div>

                <span class="section-label">
                    TASK CREATED
                </span>

                <h1>
                    Your task is ready!
                </h1>

                <p class="success-message">
                    Your task has been successfully created and added to your TaskFlow workspace.
                </p>


                <!-- Task Details -->
                <div class="task-details">

                    <h2>
                        <%= title %>
                    </h2>

                    <p class="task-description">
                        <%= description %>
                    </p>


                    <!-- Task Information -->
                    <div class="task-info">

                        <div class="info-card">
                            <span>Priority</span>
                            <strong>
                                <%= priority %>
                            </strong>
                        </div>

                        <div class="info-card">
                            <span>Category</span>
                            <strong>
                                <%= category %>
                            </strong>
                        </div>

                        <div class="info-card">
                            <span>Due Date</span>
                            <strong>
                                <%= dueDate %>
                            </strong>
                        </div>

                    </div>

                </div>


                <!-- Actions -->
                <div class="success-actions">

                    <a href="/" class="btn submit-button">
                        Create Another Task
                    </a>

                    <a href="/" class="secondary-button">
                        ← Back to Dashboard
                    </a>

                </div>

            </div>

        </div>

    </main>


    <!-- Footer -->
    <footer class="footer">
        <div class="container text-center">
            <p>
                TaskFlow • Simple task management for better productivity
            </p>
        </div>
    </footer>

</body>

</html>