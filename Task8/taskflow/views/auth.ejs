<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TaskFlow - Authentication</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand fw-bold">
                TaskFlow
            </span>
        </div>
    </nav>

    <main class="container py-5">

        <div class="text-center mb-5">
            <h1 class="fw-bold">
                Welcome to TaskFlow
            </h1>

            <p class="text-muted">
                Organize your tasks. Stay productive.
            </p>
        </div>

        <div class="row g-4 justify-content-center">

            <div class="col-md-5">

                <div class="card shadow-sm p-4 h-100">

                    <h3 class="mb-4">
                        Create Account
                    </h3>

                    <form id="registerForm">

                        <div class="mb-3">
                            <label for="registerUsername" class="form-label">
                                Username
                            </label>

                            <input type="text" id="registerUsername" class="form-control" placeholder="Enter username" required>
                        </div>

                        <div class="mb-3">
                            <label for="registerEmail" class="form-label">
                                Email
                            </label>

                            <input type="email" id="registerEmail" class="form-control" placeholder="Enter email" required>
                        </div>

                        <div class="mb-3">
                            <label for="registerPassword" class="form-label">
                                Password
                            </label>

                            <input type="password" id="registerPassword" class="form-control" placeholder="Enter password" required>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Register
                        </button>

                        <p id="registerMessage" class="mt-3"></p>

                    </form>

                </div>

            </div>

            <div class="col-md-5">

                <div class="card shadow-sm p-4 h-100">

                    <h3 class="mb-4">
                        Login
                    </h3>

                    <form id="loginForm">

                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">
                                Email
                            </label>

                            <input type="email" id="loginEmail" class="form-control" placeholder="Enter email" required>
                        </div>

                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">
                                Password
                            </label>

                            <input type="password" id="loginPassword" class="form-control" placeholder="Enter password" required>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            Login
                        </button>

                        <p id="loginMessage" class="mt-3"></p>

                    </form>

                </div>

            </div>

        </div>

    </main>

    <script src="/js/script.js"></script>

</body>

</html>